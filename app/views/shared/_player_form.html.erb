<div id="players">
  <%= form.fields_for :players do |player_form| %>
    <div class="card mb-3 player-fields">
      <div class="card-body">

        <div class="row g-3">

          <div class="col-md-3">
            <%= player_form.label :name, "First Name", class: "form-label" %>
            <%= player_form.text_field :name, class: "form-control" %>
          </div>

          <div class="col-md-3">
            <%= player_form.label :surname, class: "form-label" %>
            <%= player_form.text_field :surname, class: "form-control" %>
          </div>

          <div class="col-md-2">
            <%= player_form.label :number, class: "form-label" %>
            <%= player_form.number_field :number, class: "form-control" %>
          </div>

          <div class="col-md-2">
            <%= player_form.label :position, class: "form-label" %>
            <%= player_form.select :position,
                                   [
                                     "Setter",
                                     "Outside Hitter",
                                     "Opposite",
                                     "Middle Blocker",
                                     "Libero"
                                   ],
                                   { include_blank: "Select..." },
                                   class: "form-select" %>
          </div>

          <div class="col-md-2">
            <%= player_form.label :date_of_birth, class: "form-label" %>
            <%= player_form.date_field :date_of_birth, class: "form-control" %>
          </div>

        </div>
      </div>
    </div>
  <% end %>
</div>